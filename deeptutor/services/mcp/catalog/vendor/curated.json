{
  "version": 1,
  "note": "Remote-transport-first curated MCP catalog. Every endpoint below was verified by sending an MCP `initialize` request to it, and every credential target was taken from the server's own auth challenge or from the vendor's documentation. stdio entries carry self_service:false because a command is host execution as the app user. logo_url is intentionally empty everywhere: a third-party logo CDN would receive every user's installed-service list on each render.",
  "entries": [
    {
      "id": "airtable",
      "display_name": "Airtable",
      "category": "business",
      "tier": "curated",
      "trust": "unverified",
      "transport": "streamableHttp",
      "description": {
        "en": "Read and update Airtable bases, tables, and records.",
        "zh": "读取并更新 Airtable 的 base、数据表与记录。"
      },
      "requires": {
        "en": "Airtable personal access token.",
        "zh": "需要 Airtable 个人访问令牌。"
      },
      "server": {
        "url": "https://mcp.airtable.com/mcp",
        "tool_timeout": 60
      },
      "fields": [
        {
          "key": "token",
          "label": {
            "en": "Airtable access token",
            "zh": "Airtable 访问令牌"
          },
          "target": [
            "header",
            "Authorization"
          ],
          "placeholder": "pat...",
          "value_template": "Bearer {value}"
        }
      ],
      "homepage": "https://airtable.com",
      "docs_url": "https://airtable.com/developers/web/api/introduction"
    },
    {
