                        </xs:restriction>
                    </xs:simpleType>
                </xs:attribute>
                <xs:attribute name="muted" use="optional">
                    <xs:simpleType>
                        <xs:annotation>
                            <xs:documentation source="documentation">
                                Definition of the muted attribute used on HTML5 tags e.g. video and audio. This enumerati-
                                on is used to bridge between the HTML definition of how the Boolean data-type is to be in-
                                terpreted and the avoiding the use of empty or null attribute values in XML.              
                            </xs:documentation>
