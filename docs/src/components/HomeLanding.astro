---
interface Props {
  locale?: "en" | "zh";
}

const { locale = "en" } = Astro.props;
const zh = locale === "zh";
const root = zh ? "/zh-cn" : "";

const copy = zh
  ? {
      docs: "文档",
      eduhub: "EduHub",
      community: "社区",
      collaborate: "合作",
      theme: "主题",
      auto: "自动",
      light: "浅色",
      dark: "深色",
      language: "语言",
      taglineLead: "个性化学习，",
      taglineEm: "重新想象。",
      subLead: "Agent-native 学习伴侣，与你一起成长。",
      subRest: "完全开源。",
      docsBtn: "文档",
      eduhubBtn: "EduHub 生态",
      stars: "Stars",
      shotAlt: "当前 dev 主页：主页、学习、资料随工作区切换，伙伴和个性化属于账户。",
      eightLead: "八个入口，",
      eightEm: "串起",
      eightRest: "你的学习。",
      eightBody:
        "对话、日历、笔记本、学习、资料跟随当前工作区；伙伴与个性化属于账户。切换科目时复用熟悉的助手，同时让各项目的材料保持清晰。",
      installLead: "几",
      installEm: "分钟",
      installRest: "就能跑起来。",
      installBody: "四种安装方式 —— 挑一个适合你的。最终都落到同一个配置好的工作区。",
      fullGuide: "完整指南",
      footerDocs: "文档",
      footerCommunity: "社区",
      footerProject: "项目",
      footerLead: "源自",
      footerEm1: "社区",
      footerMid: "，连接",
      footerEm2: "世界",
      footerEnd: "。",
      footerLatest: "最新：",
      visits: "次访问",
      requests: "次请求",
      credit: "香港大学数据智能实验室",
      license: "基于 Apache 2.0 协议发布",
    }
  : {
      docs: "Docs",
      eduhub: "EduHub",
      community: "Community",
      collaborate: "Collaborate",
      theme: "Theme",
      auto: "Auto",
      light: "Light",
      dark: "Dark",
      language: "Language",
      taglineLead: "Personal tutoring,",
      taglineEm: "reimagined.",
      subLead: "Agent-native Learning Companion that grows with you.",
      subRest: "Fully Open-Sourced.",
      docsBtn: "Docs",
      eduhubBtn: "EduHub Ecosystem",
      stars: "Stars",
      shotAlt:
        "Current dev Home, with workspace-scoped Home, Learning and Resources and account-level Partners and Personalization.",
      eightLead: "Eight places, ",
      eightEm: "one",
      eightRest: " learning flow.",
      eightBody:
        "Chat, Calendar, Notebook, Learning, and Resources follow your active workspace. Partners and Personalization belong to your account, ready to support another subject without mixing its materials with this one.",
      installLead: "Up and running in ",
      installEm: "minutes",
      installRest: ".",
      installBody: "Four ways to install — pick the one that fits. Every path lands at the same configured workspace.",
      fullGuide: "Full guide",
      footerDocs: "Docs",
      footerCommunity: "Community",
      footerProject: "Project",
      footerLead: "From the ",
      footerEm1: "community",
      footerMid: ", to ",
      footerEm2: "the world",
      footerEnd: ".",
      footerLatest: "Latest:",
      visits: "Visits",
      requests: "Requests",
      credit: "Data Intelligence Lab @ The University of Hong Kong",
      license: "Released under the Apache 2.0 License",
    };

const places = zh
  ? [
      ["I", "工作区", "按科目或项目分开组织，让各自的对话、学习与资料留在对应工作区。", `${root}/learning-workspace/workspaces/`],
      ["II", "对话", "结合上下文提问、选择模式，由同一个智能体循环调用工具、技能与资料。", `${root}/learning-workspace/chat/`],
      ["III", "日历", "把账号日程与工作区任务、到期复习、定时指令和学习活动放在一起规划。", `${root}/learning-workspace/calendar/`],
      ["IV", "笔记本", "把来源整理成自己的页面，与 Dito 讨论段落，并从收藏夹插入证据。", `${root}/learning-workspace/notebook/`],
      ["V", "学习", "通过书籍、精通之路、阅读与练习开展学习，对话始终围绕当前活动。", `${root}/learning-workspace/`],
      ["VI", "资料", "复用当前工作区的聊天记录、收藏、题目、学习日志与知识库。", `${root}/learning-workspace/resources/`],
      ["VII", "伙伴", "账户级的持久伙伴，拥有明确的工作上下文、可复用指令与 IM 渠道。", `${root}/channels/`],
      ["VIII", "个性化", "将角色、技能、外部智能体和已连接工具带到不同工作区使用。", `${root}/customize/`],
    ]
  : [
      ["I", "Workspaces", "Separate subjects and projects; keep each workspace’s conversations, learning, and resources together.", `${root}/learning-workspace/workspaces/`],
      ["II", "Chat", "Ask with context, pick a mode, and let one agent loop use your tools, skills, and sources.", `${root}/learning-workspace/chat/`],
      ["III", "Calendar", "Plan account events beside workspace tasks, due reviews, scheduled instructions, and study activity.", `${root}/learning-workspace/calendar/`],
      ["IV", "Notebook", "Turn sources into your own pages; discuss a passage with Dito and insert evidence from Favorites.", `${root}/learning-workspace/notebook/`],
      ["V", "Learning", "Study through Books, Mastery Paths, Reading, and Practice, with conversations tied to the activity.", `${root}/learning-workspace/`],
      ["VI", "Resources", "Reuse chat history, Favorites, questions, learning records, and knowledge bases from this workspace.", `${root}/learning-workspace/resources/`],
      ["VII", "Partners", "Account-level companions with explicit working context, reusable instructions, and IM channels.", `${root}/channels/`],
      ["VIII", "Personalization", "Bring your personas, skills, agents, and connected tools into different workspaces.", `${root}/customize/`],
    ];

const installs = zh
  ? [
      {
        id: "pypi",
        mark: "I",
        name: "PyPI",
        tag: "推荐",
        blurb: "1.7.0 发布后的完整 Web 应用 + CLI 安装方式。现在体验 dev 请选源码。",
        code: `# 1. 准备运行数据目录\nmkdir -p my-deeptutor && cd my-deeptutor\n\n# 2. 安装、配置、启动\npip install -U "deeptutor[full]"\ndeeptutor init\ndeeptutor start`,
        note: "然后打开 127.0.0.1:3782",
        href: `${root}/self-hosting/pypi/`,
      },
      {
        id: "docker",
        mark: "II",
        name: "Docker",
        tag: "单容器",
        blurb: "已发布的稳定版镜像。需要当前 dev 时，请使用源码构建 Dockerfile。",
        code: `docker run --rm --name deeptutor \\\n  -p 127.0.0.1:3782:3782 \\\n  -v deeptutor-data:/app/data \\\n  ghcr.io/hkuds/deeptutor:latest`,
        note: "打开 127.0.0.1:3782 即可，应用会在内部代理 API。数据持久化在命名 volume 里。",
        href: `${root}/get-started/docker/`,
      },
      {
        id: "source",
        mark: "III",
        name: "源码",
        tag: "贡献者",
        blurb: "使用当前 dev 源码，安装完整 Python 依赖与前端。",
        code: `git clone --branch dev https://github.com/HKUDS/DeepTutor.git\ncd DeepTutor\n\npython3 -m venv .venv && source .venv/bin/activate\npython -m pip install -r requirements/full.txt\npython -m pip install -e . --no-deps\n( cd web && npm ci --legacy-peer-deps )\n\ndeeptutor init && deeptutor start`,
        note: "Python 3.11–3.14 · Node.js 22 LTS。start 加 --dev 可启用前端热重载。",
        href: `${root}/self-hosting/source/`,
      },
      {
        id: "cli",
        mark: "IV",
        name: "CLI",
        tag: "无界面",
        blurb: "从终端使用当前 dev 源码；若要最小 core 环境，请按指南选择独立 wheel 安装。",
        code: `git clone --branch dev https://github.com/HKUDS/DeepTutor.git\ncd DeepTutor\n\npython3 -m venv .venv-cli && source .venv-cli/bin/activate\npython -m pip install -r requirements/full.txt\npython -m pip install -e . --no-deps\n\ndeeptutor init --cli\ndeeptutor chat`,
        note: "跳过前端安装。使用知识库时配置 embedding；运行可选能力前检查模块状态。",
        href: `${root}/self-hosting/cli-only/`,
      },
    ]
  : [
      {
        id: "pypi",
        mark: "I",
        name: "PyPI",
        tag: "After 1.7.0",
        blurb: "Full Web app + CLI after 1.7.0 publication. Use Source to try the current dev now.",
        code: `# 1. Choose a runtime-home directory\nmkdir -p my-deeptutor && cd my-deeptutor\n\n# 2. Install, configure, launch\npip install -U "deeptutor[full]"\ndeeptutor init\ndeeptutor start`,
        note: "Then open 127.0.0.1:3782",
        href: `${root}/self-hosting/pypi/`,
      },
      {
        id: "docker",
        mark: "II",
        name: "Docker",
        tag: "One container",
        blurb: "Published stable image. To run current dev, build the source Dockerfile.",
        code: `docker run --rm --name deeptutor \\\n  -p 127.0.0.1:3782:3782 \\\n  -v deeptutor-data:/app/data \\\n  ghcr.io/hkuds/deeptutor:latest`,
        note: "Open 127.0.0.1:3782 — the app proxies the API internally. Data persists in the named volume.",
        href: `${root}/get-started/docker/`,
      },
      {
        id: "source",
        mark: "III",
        name: "Source",
        tag: "Contributors",
        blurb: "Use the current dev source with the complete Python dependencies and frontend.",
        code: `git clone --branch dev https://github.com/HKUDS/DeepTutor.git\ncd DeepTutor\n\npython3 -m venv .venv && source .venv/bin/activate\npython -m pip install -r requirements/full.txt\npython -m pip install -e . --no-deps\n( cd web && npm ci --legacy-peer-deps )\n\ndeeptutor init && deeptutor start`,
        note: "Python 3.11–3.14 · Node.js 22 LTS. Add --dev to start for frontend hot reload.",
        href: `${root}/self-hosting/source/`,
      },
      {
        id: "cli",
        mark: "IV",
        name: "CLI",
        tag: "Headless",
        blurb: "Use the current source from a terminal. The minimal core wheel is a separate installation choice.",
        code: `git clone --branch dev https://github.com/HKUDS/DeepTutor.git\ncd DeepTutor\n\npython3 -m venv .venv-cli && source .venv-cli/bin/activate\npython -m pip install -r requirements/full.txt\npython -m pip install -e . --no-deps\n\ndeeptutor init --cli\ndeeptutor chat`,
        note: "No frontend setup. Configure embedding when using knowledge bases; check modules before running optional capabilities.",
        href: `${root}/self-hosting/cli-only/`,
      },
    ];

const communityHref = zh ? "https://deeptutor.info/zh-cn/community/" : "https://deeptutor.info/community/";
const collaborateHref = zh ? "https://deeptutor.info/zh-cn/collaborate/" : "https://deeptutor.info/collaborate/";
const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
---

<div class="dt-landing">
  <header class="nav">
    <div class="nav-inner">
      <a class="nav-brand" href={`${root}/`} aria-label="DeepTutor">
        <svg class="nav-brand-home" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="dt-home-grad" gradientUnits="userSpaceOnUse" x1="3" y1="4" x2="21" y2="20">
              <stop offset="0" stop-color="#8CBBE0"></stop>
              <stop offset="1" stop-color="#EBBE98"></stop>
            </linearGradient>
          </defs>
          <path d="M3 11 L11.2 4.4 Q12 3.7 12.8 4.4 L21 11 M5.6 9.6 L5.6 19 Q5.6 20 6.6 20 L17.4 20 Q18.4 20 18.4 19 L18.4 9.6 M9.8 20 L9.8 15.6 Q9.8 13.6 12 13.6 Q14.2 13.6 14.2 15.6 L14.2 20" stroke="url(#dt-home-grad)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <img class="nav-brand-mark" src="/brand/color-logo.png" alt="" aria-hidden="true" />
        <img class="nav-brand-wordmark" src="/brand/color-word.png" alt="DeepTutor" />
      </a>
      <nav class="nav-links">
        <a class="nav-text" href={`${root}/welcome/`}>{copy.docs}</a>
        <a class="nav-text" href="https://eduhub.deeptutor.info" target="_blank" rel="noopener">{copy.eduhub}</a>
        <a class="nav-text" href={communityHref}>{copy.community}</a>
        <a class="nav-text" href={collaborateHref}>{copy.collaborate}</a>
      </nav>
      <div class="nav-tools" aria-label="Preferences">
        <div class="nav-social">
          <a class="nav-icon" href="https://github.com/HKUDS/DeepTutor" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
            <svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
          </a>
          <a class="nav-icon" href="https://discord.gg/eRsjPgMU4t" target="_blank" rel="noopener" aria-label="Discord" title="Discord">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.27 5.33C17.94 4.71 16.5 4.26 15 4a.09.09 0 0 0-.07.03c-.18.33-.39.76-.53 1.09a16.09 16.09 0 0 0-4.8 0c-.14-.34-.35-.76-.54-1.09-.01-.02-.04-.03-.07-.03-1.5.26-2.93.71-4.27 1.33-.01 0-.02.01-.03.02-2.72 4.07-3.47 8.03-3.1 11.95 0 .02.01.04.03.05 1.8 1.32 3.53 2.12 5.24 2.65.03.01.06 0 .07-.02.4-.55.76-1.13 1.07-1.74.02-.04 0-.08-.04-.09-.57-.22-1.11-.48-1.64-.78-.04-.02-.04-.08-.01-.11.11-.08.22-.17.33-.25.02-.02.05-.02.07-.01 3.44 1.57 7.15 1.57 10.55 0 .02-.01.05-.01.07.01.11.09.22.17.33.26.04.03.04.09-.01.11-.52.31-1.07.56-1.64.78-.04.01-.05.06-.04.09.32.61.68 1.19 1.07 1.74.03.01.06.02.09.01 1.72-.53 3.45-1.33 5.25-2.65.02-.01.03-.03.03-.05.44-4.53-.73-8.46-3.1-11.95-.01-.01-.02-.02-.04-.02zM8.52 14.91c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.84 2.12-1.89 2.12zm6.97 0c-1.03 0-1.89-.95-1.89-2.12s.84-2.12 1.89-2.12c1.06 0 1.9.96 1.89 2.12 0 1.17-.83 2.12-1.89 2.12z"></path></svg>
          </a>
          <a class="nav-icon" href="https://github.com/HKUDS/DeepTutor/issues/78" target="_blank" rel="noopener" aria-label={zh ? "微信社区" : "WeChat community"} title={zh ? "微信社区" : "WeChat community"}>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.69 4C4.55 4 1.2 6.68 1.2 10c0 1.86 1.04 3.51 2.69 4.61l-.7 2.4 2.79-1.5c.83.3 1.74.49 2.7.49.34 0 .67-.02 1-.06-.13-.46-.21-.94-.21-1.43 0-3.07 2.97-5.5 6.7-5.5.33 0 .67.02 1 .07C16.39 6.32 12.86 4 8.69 4ZM6.18 8.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm5 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm5 1c-3.3 0-6 2.24-6 5s2.7 5 6 5c.74 0 1.45-.12 2.1-.34L20.2 20l-.7-2.05c1.07-.95 1.7-2.15 1.7-3.45 0-2.76-2.7-5-6-5Zm-2 4a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Zm4 0a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z"></path></svg>
          </a>
        </div>
        <span class="nav-tool-divider" aria-hidden="true"></span>
        <label class="nav-tool" aria-label={copy.theme}>
          <svg class="nav-tool-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
          <select class="nav-select" data-theme-select aria-label={copy.theme}>
            <option value="auto">{copy.auto}</option>
            <option value="light">{copy.light}</option>
            <option value="dark">{copy.dark}</option>
          </select>
          <svg class="nav-tool-caret" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 4.5 6 7.5 9 4.5"></polyline></svg>
        </label>
        <label class="nav-tool" aria-label={copy.language}>
          <svg class="nav-tool-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"></circle><path d="M2.5 12h19"></path><path d="M12 2.5a14 14 0 0 1 4 9.5 14 14 0 0 1-4 9.5 14 14 0 0 1-4-9.5 14 14 0 0 1 4-9.5z"></path></svg>
          <select class="nav-select" data-locale-select aria-label={copy.language}>
            <option value="/" selected={!zh}>English</option>
            <option value="/zh-cn/" selected={zh}>简体中文</option>
          </select>
          <svg class="nav-tool-caret" width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 4.5 6 7.5 9 4.5"></polyline></svg>
        </label>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <img class="hero-wordmark" src="/brand/color-word.png" alt="DeepTutor" />
      <h1 class="hero-tagline">{copy.taglineLead}<br /><em>{copy.taglineEm}</em></h1>
      <p class="hero-sub">{copy.subLead}<br />{copy.subRest}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`${root}/welcome/`}>{copy.docsBtn}</a>
        <a class="btn btn-ghost" href="https://eduhub.deeptutor.info">{copy.eduhubBtn}</a>
        <a class="btn btn-ghost btn-gh" href="https://github.com/HKUDS/DeepTutor" target="_blank" rel="noopener" aria-label="DeepTutor on GitHub">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
          <span>GitHub</span>
          <span class="btn-gh-sep" aria-hidden="true"></span>
          <span class="btn-gh-count" data-gh-stars>—</span>
          <span class="btn-gh-label">{copy.stars}</span>
        </a>
      </div>
    </section>

    <section class="showcase">
      <div class="showcase-frame">
        <img class="showcase-shot" src="/screenshots/dev/overview.png" alt={copy.shotAlt} loading="eager" decoding="async" />
      </div>
    </section>

    <section class="section">
      <header class="section-head">
        <h2>{copy.eightLead}<em>{copy.eightEm}</em>{copy.eightRest}</h2>
        <p>{copy.eightBody}</p>
      </header>
      <div class="feature-grid">
        {places.map(([mark, title, body, href]) => (
          <a class="feature" href={href}>
            <span class="feature-mark">{mark}</span>
            <h3>{title}</h3>
            <p>{body}</p>
            <span class="feature-arrow" set:html={arrow} />
          </a>
        ))}
      </div>
    </section>

    <section class="section section-quiet">
      <header class="section-head">
        <h2>{copy.installLead}<em>{copy.installEm}</em>{copy.installRest}</h2>
        <p>{copy.installBody}</p>
      </header>
      <div class="install" id="install">
        <div class="install-rail" role="tablist">
          {installs.map((item, index) => (
            <button class:list={["install-opt", { "is-active": index === 0 }]} role="tab" aria-selected={index === 0 ? "true" : "false"} data-target={item.id}>
              <span class="install-opt-mark">{item.mark}</span>
              <span class="install-opt-text">
                <span class="install-opt-name">{item.name}</span>
                <span class="install-opt-tag">{item.tag}</span>
              </span>
