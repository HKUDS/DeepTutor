---
import { logos } from "virtual:starlight/user-images";
import config from "virtual:starlight/user-config";

// 文档页眉左上角：手绘 home 图标 + DeepTutor logo 一起跳回 deeptutor.info 落地页
// （home 图标让可点性更明显）。紧邻其右是 EduHub 入口——原在左侧栏，移到顶部。
const LANDING_URL = "https://deeptutor.info";
const EDUHUB_URL = "https://eduhub.deeptutor.info";
---

<div class="dt-brand sl-flex">
  <a href={LANDING_URL} class="site-title sl-flex" aria-label="DeepTutor">
    <svg class="site-title-home" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <defs>
        <linearGradient
          id="dt-home-grad"
          gradientUnits="userSpaceOnUse"
          x1="3"
          y1="4"
          x2="21"
          y2="20"
        >
          <stop offset="0" stop-color="#8CBBE0"></stop>
          <stop offset="1" stop-color="#EBBE98"></stop>
        </linearGradient>
      </defs>
      <path
        d="M3 11 L11.2 4.4 Q12 3.7 12.8 4.4 L21 11 M5.6 9.6 L5.6 19 Q5.6 20 6.6 20 L17.4 20 Q18.4 20 18.4 19 L18.4 9.6 M9.8 20 L9.8 15.6 Q9.8 13.6 12 13.6 Q14.2 13.6 14.2 15.6 L14.2 20"
        stroke="url(#dt-home-grad)"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    {
      config.logo && logos.dark && (
        <img
          class="site-title-mark"
          alt=""
          aria-hidden="true"
          src={logos.dark.src}
          width={logos.dark.width}
          height={logos.dark.height}
        />
      )
    }
    <img class="site-title-wordmark" src="/brand/color-word.png" alt="DeepTutor" />
  </a>
  <a class="dt-eduhub" href={EDUHUB_URL} target="_blank" rel="noopener">EduHub</a>
</div>

<style>
  .dt-brand {
    align-items: center;
    min-width: 0;
  }
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    min-width: 0;
  }
  .site-title-home {
    height: 23px;
    width: 23px;
    flex-shrink: 0;
  }
  .site-title-mark {
    height: 26px;
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
  }
  .site-title-wordmark {
    height: 22px;
    width: auto;
    user-select: none;
    object-fit: contain;
  }
  [data-theme="dark"] .site-title-wordmark {
    filter: invert(1) hue-rotate(180deg) brightness(1.12);
  }
  .dt-eduhub {
    margin-left: 16px;
    padding-left: 16px;
    border-left: 1px solid var(--sl-color-hairline);
    font-family: "Geist", -apple-system, sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1;
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .dt-eduhub:hover {
    color: var(--sl-color-text-accent);
  }
</style>
