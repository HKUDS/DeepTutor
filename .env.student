# ============================================
# MathTutor — 学生本地配置
# ============================================
# 复制此文件为 .env 并填入你的信息。
# .env 不会被 git 跟踪，也不会被推送到 GitHub。
# ============================================

# --- 端口 ---
BACKEND_PORT=8002
FRONTEND_PORT=3782

# --- LLM（DeepSeek API）---
# 在 https://platform.deepseek.com 注册并创建 API Key
LLM_BINDING=deepseek
LLM_MODEL=deepseek-chat
# 替换为你的 DeepSeek API Key（sk- 开头）
LLM_API_KEY=你的DeepSeek-API-Key
LLM_HOST=https://api.deepseek.com

# --- Embedding（硅基流动 / SiliconFlow）---
# 在 https://siliconflow.cn 注册并创建 API Key
# 用于将 MathNet 题库转为向量索引
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=BAAI/bge-m3
# 替换为你的 SiliconFlow API Key（sk- 开头）
EMBEDDING_API_KEY=你的SiliconFlow-API-Key
EMBEDDING_HOST=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_DIMENSION=1024

# --- MathNet 云端题库 ---
# 题库数据工厂地址，用于一键同步
MATHNET_CLOUD_URL=http://8.138.199.23:8080

# --- 认证（单用户模式，留空即可）---
AUTH_ENABLED=false
