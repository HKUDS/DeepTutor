# ============================================
# DeepTutor Project .gitignore
# ============================================

# ============================================
# User Generated Data and Outputs
# ============================================
# Runtime data (knowledge bases, partner workspaces, memory, etc.)
data/
/multi-user/
# Local development documents; public guides live in docs-for-user/.
/docs/
/design-qa.md
/site/
.claude
.agents/
.workbuddy/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.pdf
!tests/fixtures/lightrag_bridge/original.pdf
!tests/fixtures/lightrag_bridge/mineru-v2-current/*_origin.pdf

# ============================================
# Python Related
# ============================================
# Bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution/Packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Environment configuration (keep the public template)
.env
.env.*
*.env
*.env.local
!.env.example

# Virtual environments
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/

# ============================================
# Node.js and Frontend Build
# ============================================
# Node modules
# No trailing slash: also ignore symlinked installs borrowed by worktrees.
node_modules

# Next.js build output
.next/
# Custom distDir builds (DEEPTUTOR_NEXT_DIST_DIR / parallel dev servers)
web/.next-*/
# PDF.js decoder files are copied from node_modules for local/dev and release
# builds; they are dependency-generated assets, not source files.
web/public/pdfjs/
# Per-process TypeScript configs used by isolated build/typecheck wrappers
web/tsconfig.deeptutor-*.json
# Temporary Next.js dist roots created by isolated build/test runs
web/tmp/
out/
.vercel/
.turbo/

# Frontend build artifacts
.open-next/
.wrangler/
.vite/

# Yarn / Plug'n'Play
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TypeScript build info
*.tsbuildinfo

# ============================================
# Common Output and Cache Directories
# ============================================
# Output directories
output/
outputs/

# Cache directories
cache/
.cache/
.ruff_cache
.import_linter_cache/
.playwright-cli/
# Written by `npm run audit` (the playwright ui-audit project).
web/test-results/
web/playwright-report/

# Log files
*.log

# ============================================
# IDE and Editors
# ============================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Cursor
.cursor/

# PyCharm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.bak
*.backup

# Local scripts
启动 DeepTutor.bat

# ============================================
# Testing and Coverage
# ============================================
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.pytest_tmp/
.tox/
nosetests.xml
coverage.xml
develop/

# ============================================
# Jupyter Notebook
# ============================================
.ipynb_checkpoints
*.ipynb_checkpoints/

# ============================================
# Type Checking
# ============================================
# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# ============================================
# Profiling
# ============================================
*.prof
*.pstats

# ============================================
# Database Files
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# Compressed Files
# ============================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ============================================
# Audio/Video Output (TTS generated)
# ============================================
*.mp3
*.wav
*.ogg
