# ============================================
# DeepTutor (podman compose) — host-side configuration
# ============================================
# Copy to .env and edit. `.env` is gitignored.
#
# All values are loopback bindings on the HOST side. The container-side
# ports come from data/user/settings/system.json (backend_port, frontend_port).
# Edit those + `podman compose restart deeptutor` to change the in-container
# ports. This file is for shifting the host-side mapping only.
#
# The API base URL the browser uses is NOT a compose env var. The
# entrypoint reads `DEEPTUTOR_API_BASE_URL` from
# data/user/settings/system.json on every start (preferring the
# in-network `next_public_api_base`, then the external override
# `next_public_api_base_external`, then `http://localhost:${BACKEND_PORT}`),
# and web/proxy.ts rewrites /api/* and /ws/* to it at request time.
# ============================================

# Host-side loopback bindings (override if 8001/3782/8090 are taken)
HOST_PORT_BACKEND=8001
HOST_PORT_FRONTEND=3782
HOST_PORT_POCKETBASE=8090

# Time zone passed into both backend and frontend.
TZ=UTC

# Public email registration (leave blank for local single-user runs).
# DEEPTUTOR_SMTP_HOST=smtp.example.com
# DEEPTUTOR_SMTP_PORT=587
# DEEPTUTOR_SMTP_USERNAME=mailer@example.com
# DEEPTUTOR_SMTP_PASSWORD=
# DEEPTUTOR_SMTP_FROM=DeepTutor <mailer@example.com>
# DEEPTUTOR_SMTP_USE_TLS=true
# DEEPTUTOR_SMTP_USE_SSL=false
# DEEPTUTOR_SMTP_TIMEOUT_SECONDS=10

# BYOK for authenticated multi-user deployments. Keep the master key in a
# deployment-only secret store; it is used to encrypt provider credentials at
# rest and must not be exposed as a NEXT_PUBLIC_* variable.
# DEEPTUTOR_BYOK_ENABLED=true
# DEEPTUTOR_BYOK_MASTER_KEY_FILE=/run/secrets/deeptutor_byok_master_key
# Generate once with `openssl rand -hex 32`, then keep this value stable.
# DEEPTUTOR_BYOK_MASTER_KEY=
# DEEPTUTOR_BYOK_USAGE_DB_PATH=/app/data/system/byok_usage.sqlite3

# Optional LiteLLM overlay. These values belong in a deployment-only env file,
# not in the repository. The overlay uses managed PostgreSQL for persistent
# virtual keys, budgets, spend, and rate-limit state.
# LITELLM_DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
# LITELLM_MASTER_KEY=
# UPSTREAM_MODEL=openai/gpt-4o-mini
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=
