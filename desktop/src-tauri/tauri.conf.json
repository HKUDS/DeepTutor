{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepTutor",
  "version": "1.6.10",
  "identifier": "com.deeptutor.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["deeptutor"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/st01cs/DeepTutor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1Qzg2RURBMTY4MEI1NTQKUldSVXRZQVcybTdJNVhRZDdHd1dHbzRwcml1U1kzNHRUM2FxRFptaVdRN1NZV3VzTFdZV2ZCTjcK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "contentTypes": ["com.adobe.pdf"],
        "name": "PDF document",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["epub"],
        "contentTypes": ["org.idpf.epub-container"],
        "name": "EPUB book",
        "description": "EPUB book",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": ["md", "markdown"],
        "contentTypes": ["net.daringfireball.markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
