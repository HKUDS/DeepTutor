{
  "name": "deeptutor-desktop",
  "version": "1.0.0",
  "description": "DeepTutor - Agent-Native Personalized Tutoring",
  "main": "./out/main/index.js",
  "author": "HKUDS",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:electron": "electron-vite dev",
    "prebuild": "cd ../web && npm run build",
    "build": "electron-vite build",
    "postbuild": "node scripts/copy-next-build.mjs",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && node scripts/rebuild-native.mjs",
    "dist": "npm run build && electron-builder --win --mac --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.3.4",
    "electron-updater": "^6.3.9",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^3.7.1",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
