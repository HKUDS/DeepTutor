{
  "name": "deeptutor-frontend",
  "description": "DeepTutor web frontend — SeedCode TraeWork chassis (from Askora apps/frontend)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:baseline": "node scripts/generate-baselines.mjs",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:all": "npm run test:baseline && npm run test:visual"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.7.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3"
  }
}
