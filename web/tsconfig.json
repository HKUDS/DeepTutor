{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-deeptutor/types/**/*.ts",
    ".next-deeptutor/dev/types/**/*.ts",
    ".next-verify-84/types/**/*.ts",
    ".next-verify-84/dev/types/**/*.ts",
    ".next-reading/types/**/*.ts",
    ".next-reading/dev/types/**/*.ts",
    ".next-sidebar-dev/types/**/*.ts",
    ".next-sidebar-dev/dev/types/**/*.ts",
    ".next-sidebar/types/**/*.ts",
    ".next-sidebar/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
